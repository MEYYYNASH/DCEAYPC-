<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DCEAY Music App</AssemblyName>
    <RootNamespace>DceayMusicApp</RootNamespace>
    <ApplicationTitle>DCEAY Music App</ApplicationTitle>
    <Company>DCEAY</Company>
    <Product>DCEAY Music App</Product>
    <Description>DCEAY Music App - Premium Music Player</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\app\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>www\%(RecursiveDir)%(FileName)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>